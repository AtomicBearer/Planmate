# Copy to .env for local use. On a host, set private environment variables instead.
# Keep API keys on the server. Full setup: docs/API-CONNECTIONS.md.
# Public-link deployment checklist: docs/DEPLOYMENT.md and pnpm run check:launch.

# Node host settings. Public deployment: HOST=0.0.0.0; the host usually supplies PORT.
HOST=
PORT=3000

# Google Identity Services Web client ID (not a Maps API key or OAuth client secret).
GOOGLE_CLIENT_ID=
# Guest mode supports device profiles. Public verified accounts: ACCOUNT_MODE=required.
# Required mode refuses startup without a configured client ID.
ACCOUNT_MODE=guest
# Public HTTPS deployments: set the exact origin and SESSION_SECURE=true.
PUBLIC_ORIGIN=
SESSION_SECURE=false
# Optional absolute directory for plans.sqlite and member-uploaded media.
PLANMATE_DATA_DIR=

GOOGLE_PLACES_API_KEY=

# Prefer an authorised India/city-specific event partner feed (contract in README).
EVENTS_FEED_URL=
EVENTS_FEED_TOKEN=

# Optional alternative; coverage in Indian cities may be limited.
TICKETMASTER_API_KEY=

# Optional Google Static Maps API key, enabled and restricted on the server.
GOOGLE_STATIC_MAPS_API_KEY=

# Optional direct Google Routes API key. Enable Routes API and billing in Google Cloud.
# Driving durations exclude live traffic and never replace manual buffers automatically.
GOOGLE_ROUTES_API_KEY=

# Optional authorised routing feed; takes precedence over Google Routes. Contract in docs.
ROUTES_FEED_URL=
ROUTES_FEED_TOKEN=
