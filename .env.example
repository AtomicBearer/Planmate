# Enable Places API (New) in Google Cloud and configure billing and key restrictions.
# Keep credentials on the server. This file contains placeholders only.
GOOGLE_CLIENT_ID=
# Local demo allows unverified demo trips. Required mode refuses startup without a client ID.
ACCOUNT_MODE=demo
# Public HTTPS deployments: set the exact origin and SESSION_SECURE=true.
PUBLIC_ORIGIN=
SESSION_SECURE=false
# Optional absolute directory for plans.sqlite and member-uploaded media.
PLANMATE_DATA_DIR=

GOOGLE_PLACES_API_KEY=

# Prefer an authorised India/city-specific event partner feed (contract in README).
EVENTS_FEED_URL=
EVENTS_FEED_TOKEN=

# Optional alternative; coverage in Indian cities may be limited.
TICKETMASTER_API_KEY=

# Optional Google Static Maps API key, enabled and restricted on the server.
GOOGLE_STATIC_MAPS_API_KEY=

# Optional authorised routing feed. Contract in README.
ROUTES_FEED_URL=
ROUTES_FEED_TOKEN=
